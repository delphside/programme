#!/usr/bin/env bash
# deliver-host: the host command (design §4, §9). `deliver host-install ENV`
# installs it with its libraries. The control node calls it over ssh, or locally
# where the environment's host is the control node:
#
#   deliver-host deploy APP ENV < request.json   pull by digest, take the payload
#                                                out of the image, run its steps
#   deliver-host rollback APP ENV < request.json
#   deliver-host status APP ENV --json
#   deliver-host env create|destroy NAME
#   deliver-host copy APP < request.json   the release copier's work: copy images
#                                           from candidates to releases by digest
#                                           and push the record image
#   deliver-host root-ops install|rm|systemctl|useradd|userdel ...
#
# It holds the environment's lock for the whole deploy or rollback (descriptor 9,
# inherited by the payload's steps). State lives in
# ${DELIVER_STATE_DIR:-/var/lib/deliver}/APP/ENV/ (design §9).
#
# DELIVER_HOST_ROOT prefixes every path this command touches. It is empty on a
# real host; the tests point it at a scratch directory so a "host" can be a folder.

set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -z "${DELIVER_LIB:-}" ]]; then
  if [[ -f "$HERE/lib/common.sh" ]]; then DELIVER_LIB="$HERE/lib"; else DELIVER_LIB=/usr/local/lib/deliver; fi
fi
export DELIVER_LIB
# shellcheck source=lib/common.sh
. "$DELIVER_LIB/common.sh"
# shellcheck source=lib/registry.sh
[[ -f "$DELIVER_LIB/registry.sh" ]] && . "$DELIVER_LIB/registry.sh"
# shellcheck source=lib/toml.sh
. "$DELIVER_LIB/toml.sh"
DELIVER_CMD="deliver-host"
need_jq

ROOT="$(host_root)"
STATE_ROOT="$ROOT${DELIVER_STATE_DIR:-/var/lib/deliver}"

env_dir() { printf '%s/%s/%s' "$STATE_ROOT" "$1" "$2"; }

state_line() { head -1 "$1/state" 2>/dev/null || true; }
state_settled() {
  case "$(state_line "$1")" in ""|finished|restored*|"failed, no previous deploy") return 0 ;; *) return 1 ;; esac
}

# the registry address of this machine: its own .env, else its environment
host_registry() {
  local f="$1/.env" v="" k
  [[ -f "$f" ]] && v="$(sed -n 's/^DELIVER_REGISTRY=//p' "$f" | head -1)"
  DELIVER_REGISTRY="${v:-${DELIVER_REGISTRY:-}}"
  [[ -n "$DELIVER_REGISTRY" ]] || die "DELIVER_REGISTRY is not set in $f or the environment"
  export DELIVER_REGISTRY
  # the login adapter's settings, from the same file (design section 5): these
  # lines only, read as text and never sourced
  if [[ -f "$f" ]]; then
    for k in DELIVER_OCI_TOKEN_CMD DELIVER_REGISTRY_USER OCI_CLI_AUTH OCI_CLI_KEY_FILE OCI_CLI_CONFIG_FILE; do
      v="$(sed -n "s/^$k=//p" "$f" | head -1)"; v="${v#\"}"; v="${v%\"}"
      [[ -z "$v" ]] || export "$k=$v"
    done
  fi
}

# take_lock ENVDIR LOCKFILE WAIT: the lock is descriptor 9, held to the end.
take_lock() {
  local lock="$2" wait="$3" waited=0 unit="${DELIVER_WAIT_UNIT:-60}"
  mkdir -p "$(dirname "$lock")"
  exec 9>>"$lock"
  DELIVER_WAIT_USED=0; export DELIVER_WAIT_USED
  if flock -n 9; then gate_ok lock "free"; return 0; fi
  if [[ -z "$wait" ]]; then gate_fail lock "the lock $lock is held by another deploy or run"; fi
  while ! flock -w "$unit" 9; do
    waited=$((waited + 1)); DELIVER_WAIT_USED=$waited
    if (( waited >= wait )); then gate_fail lock "still held after waiting $wait minute(s) for the lock $lock"; fi
  done
  gate_ok lock "free after waiting $waited minute(s)"
}

cmd_deploy() {
  local app="$1" env="$2" req envdir lock
  envdir="$(env_dir "$app" "$env")"; mkdir -p "$envdir"
  req="$(mktemp "$envdir/request.XXXXXX")"
  HOST_TMP+=("$req"); trap 'host_cleanup $?' EXIT
  cat > "$req"
  jq -e . "$req" >/dev/null 2>&1 || die "the request is not JSON"
  DELIVER_LOG_DIR="$envdir/log"; run_log_start "." deploy "$app" "$env" 2>/dev/null || true
  trap 'host_cleanup $?' EXIT
  RUN_LOG="${RUN_LOG:-}"
  GATE_EMIT=1
  host_registry "$envdir"
  local wait local_build sha repo payload timeout login
  wait="$(jq -r '.wait // empty' "$req")"; local_build="$(jq -r '.local' "$req")"
  sha="$(jq -r .sha "$req")"; repo="$(jq -r .repo "$req")"; payload="$(jq -r .payload_image "$req")"
  timeout="$(jq -r '.pull_timeout // 300' "$req")"; login="$(jq -r '.login // empty' "$req")"
  lock="$(jq -r '.lock // empty' "$req")"; lock="${lock:+$ROOT$lock}"; lock="${lock:-$envdir/lock}"

  take_lock "$envdir" "$lock" "$wait"

  if ! state_settled "$envdir"; then
    gate_fail state "the last deploy did not finish (state: $(state_line "$envdir")); run deliver rollback ENV to put the last good deploy back (a redeploy is refused until then)"
  fi
  gate_ok state "$(state_line "$envdir")"

  # every image by digest; the label must be the commit; then the payload
  [[ -z "$login" ]] || login_run "$login" || gate_fail digests "registry login ($login) failed: $REG_ERR"
  local name digest ref labels rev
  while IFS=$'\t' read -r name digest; do
    [[ -n "$name" ]] || continue
    if [[ "$local_build" == true ]]; then
      ref="$digest"
      rev="$(docker image inspect "$ref" --format '{{json .Config.Labels}}' 2>/dev/null | jq -r '.["org.opencontainers.image.revision"] // empty')" \
        || gate_fail digests "local image $name ($ref) is not there"
    else
      ref="$DELIVER_REGISTRY/$repo@$digest"
      local pcode=0
      timeout "$timeout" docker pull -q "$ref" >/dev/null 2>&1 || pcode=$?
      if [[ $pcode -eq 124 ]]; then gate_fail digests "pulling $name took longer than pull_timeout ($timeout s)"; fi
      [[ $pcode -eq 0 ]] || gate_fail digests "cannot pull $name by digest $digest"
      labels="$(docker image inspect "$ref" --format '{{json .Config.Labels}}' 2>/dev/null)" || gate_fail digests "cannot inspect $name"
      rev="$(jq -r '.["org.opencontainers.image.revision"] // empty' <<< "$labels")"
    fi
    [[ "$rev" == "$sha" ]] || gate_fail digests "image $name carries revision ${rev:-none}, not $sha: it is not this commit's build"
  done < <(jq -r '.images | to_entries[] | [.key, .value] | @tsv' "$req")
  gate_ok digests "every image pulled by digest and labelled ${sha:0:12}"

  # the payload, taken out of the image that carries it
  local pimg pref tmp cid
  pimg="$(jq -r --arg n "$payload" '.images[$n] // empty' "$req")"
  [[ -n "$pimg" ]] || die "the request names no image $payload to take the payload from"
  if [[ "$local_build" == true ]]; then pref="$pimg"; else pref="$DELIVER_REGISTRY/$repo@$pimg"; fi
  tmp="$(mktemp -d "$envdir/payload.XXXXXX")"; HOST_TMP+=("$tmp")
  cid="$(docker create "$pref")" || die "cannot create a container from $payload to read /deliver/"
  docker cp "$cid:/deliver/." "$tmp" >/dev/null || { docker rm "$cid" >/dev/null 2>&1; die "the image $payload has no /deliver/"; }
  docker rm "$cid" >/dev/null 2>&1
  [[ -x "$tmp/deploy" ]] || die "the payload has no deploy step"

  export PAYLOAD_DIR="$tmp" DELIVER_REQUEST="$req" ENVDIR="$envdir" RUN_LOG GATE_EMIT
  local code=0
  "$tmp/deploy" || code=$?
  [[ $code -eq 0 ]] || code=1
  exit "$code"
}

drop_tmp() { local d="${1:?}"; [[ -d "$d" ]] && rm -rf -- "$d"; return 0; }

# Files this run made in the state folder, removed however it ends.
HOST_TMP=()
host_cleanup() {
  local code="$1" t
  for t in "${HOST_TMP[@]}"; do
    if [[ -d "$t" ]]; then drop_tmp "$t"; elif [[ -n "$t" ]]; then rm -f -- "$t"; fi
  done
  _run_log_exit "$code"
}

cmd_rollback() {
  local app="$1" env="$2" req envdir lock wait n payload
  envdir="$(env_dir "$app" "$env")"; mkdir -p "$envdir"
  req="$(mktemp "$envdir/request.XXXXXX")"; HOST_TMP+=("$req"); trap 'host_cleanup $?' EXIT
  cat > "$req"
  DELIVER_LOG_DIR="$envdir/log"; run_log_start "." rollback "$app" "$env" 2>/dev/null || true
  trap 'host_cleanup $?' EXIT
  GATE_EMIT=1
  host_registry "$envdir"
  wait="$(jq -r '.wait // empty' "$req")"
  lock="$(jq -r '.lock // empty' "$req")"; lock="${lock:+$ROOT$lock}"; lock="${lock:-$envdir/lock}"
  take_lock "$envdir" "$lock" "$wait"
  # the steps come from the deploy being rolled back from
  payload=""
  if ! state_settled "$envdir"; then
    n="$(sed -n 's/^deploy=//p' "$envdir/state" | head -1)"
    [[ -d "$envdir/deploys/$n/payload" ]] && payload="$envdir/deploys/$n/payload"
  fi
  [[ -n "$payload" ]] || [[ ! -L "$envdir/current" ]] || payload="$envdir/current/payload"
  if [[ -z "$payload" || ! -x "$payload/rollback" ]]; then
    gate_fail rollback-target "nothing is deployed here to roll back (no payload on disk); use the application's fallback"
  fi
  export DELIVER_REQUEST="$req" ENVDIR="$envdir" RUN_LOG GATE_EMIT
  local code=0
  "$payload/rollback" || code=$?
  [[ $code -eq 0 ]] || code=1
  exit "$code"
}

# allowlist APP < lines: run by `deliver host-install` as root. It writes the application's
# host_files.allow from the profile's lines (destination, source, mode, enable), and
# keeps an entry the new list lacks for as long as something still uses it: root's own
# `installed` record names its destination, or the current or previous deploy of any
# environment lists it. So a rollback or a restore across a moved or dropped host file,
# and the stop of a dropped unit, still find their entries; an entry nothing uses is dropped.
cmd_allowlist() {
  local app="$1" new old out line dest src mode enable pj meta used dropped=() d
  new="$(cat)"
  old="$ALLOW_ROOT/$app/host_files.allow"
  mkdir -p "$ALLOW_ROOT/$app"
  out="$(mktemp "$ALLOW_ROOT/$app/.allow.XXXXXX")"
  printf '%s\n' "$new" | sed '/^$/d' > "$out"
  if [[ -f "$old" ]]; then
    while IFS=$'\t' read -r dest src mode enable; do
      [[ -n "$dest" ]] || continue
      line="$dest"$'\t'"$src"$'\t'"$mode"$'\t'"$enable"
      grep -qxF -- "$line" "$out" && continue
      used=0
      for pj in "$STATE_ROOT/$app"/*/current/payload/profile.json "$STATE_ROOT/$app"/*/previous/payload/profile.json; do
        [[ -f "$pj" ]] || continue
        meta="$(dirname "$(dirname "$pj")")/meta.json"
        [[ "$(jq -r '.host_files' "$meta" 2>/dev/null)" == true ]] || continue
        if jq -e --arg d "$dest" --arg s "$src" --arg m "$mode" \
          'any((.deliver.host_files // [])[]; .dest == $d and .src == $s and (((.mode // "0644") | ltrimstr("0")) == ($m | ltrimstr("0"))))' "$pj" >/dev/null 2>&1; then
          used=1; break
        fi
      done
      if [[ $used -eq 1 ]]; then printf '%s\n' "$line" >> "$out"; else dropped+=("$line"); fi
    done < "$old"
  fi
  chmod 0644 "$out"; mv -f "$out" "$old"
  # an entry nothing uses, whose file root-ops installed and no deploy lists any more (an
  # environment switched to host_files = false never runs the removal itself): remove the file
  for line in "${dropped[@]}"; do
    IFS=$'\t' read -r dest src mode enable <<< "$line"
    awk -F'\t' -v d="$dest" '$1 == d {f = 1} END {exit !f}' "$old" && continue
    grep -qxF -- "$dest" "$ALLOW_ROOT/$app/installed" 2>/dev/null || continue
    if [[ "$enable" == true ]]; then systemctl stop "$(basename "$dest")" || true; systemctl disable "$(basename "$dest")" || true; fi
    rm -f -- "${ROOT}${dest:?}"; forget_installed "$dest"
    d="$dest"; say "removed $d, which no deploy lists any more"
  done
}

# copy APP < request: runs on the release copier (design sections 2 and 4), with
# that machine's own registry configuration and credential. The request:
#   {login, candidates, releases, copies:[{digest, dest}], record:{tag, body}|null}
# A copy already in releases with the same digest is a no-op; with another digest
# it refuses. The record image is pushed only where its tag is absent.
cmd_copy() {
  local app="$1" req conf
  req="$(cat)"
  jq -e . >/dev/null 2>&1 <<< "$req" || die "the request is not JSON"
  conf="${DELIVER_CONFIG_DIR:-$HOME/.config/deliver}/$app.env"
  if [[ -f "$conf" ]]; then set -a; . "$conf"; set +a; fi
  [[ -n "${DELIVER_REGISTRY:-}" ]] || die "DELIVER_REGISTRY is not set for the release copier: put it in $conf"
  local login candidates releases digest dest have code
  login="$(jq -r '.login // empty' <<< "$req")"
  candidates="$(jq -r .candidates <<< "$req")"; releases="$(jq -r .releases <<< "$req")"
  [[ -z "$login" ]] || login_run "$login" || die "the copier's registry login ($login) failed: $REG_ERR"
  while IFS=$'\t' read -r digest dest; do
    [[ -n "$digest" ]] || continue
    code=0; reg_digest "$releases" "$dest" >/dev/null || code=$?; have="$REG_DIGEST"
    case $code in
      0) [[ "$have" == "$digest" ]] && continue; die "releases already holds $dest with another digest" ;;
      1) ;;
      *) die "the registry could not be queried: $REG_ERR" ;;
    esac
    reg_copy "$candidates" "$digest" "$releases" "$dest" || die "the copy of $dest to releases failed: $REG_ERR"
  done < <(jq -r '(.copies // [])[] | [.digest, .dest] | @tsv' <<< "$req")
  local rtag; rtag="$(jq -r '.record.tag // empty' <<< "$req")"
  if [[ -n "$rtag" ]]; then
    local tmp; tmp="$(mktemp)"; jq -c '.record.body' <<< "$req" > "$tmp"
    code=0; reg_inspect "$releases" "$rtag" >/dev/null || code=$?
    case $code in
      0) ;;
      1) record_push "$releases" "$rtag" "$tmp" || { rm -f "$tmp"; die "pushing the record failed: $REG_ERR"; } ;;
      *) rm -f "$tmp"; die "the registry could not be queried: $REG_ERR" ;;
    esac
    rm -f "$tmp"
  fi
}

cmd_status() {
  local app="$1" env="$2" envdir state cur prev
  envdir="$(env_dir "$app" "$env")"
  state="$(state_line "$envdir")"
  cur="$(readlink "$envdir/current" 2>/dev/null)" || cur=""
  prev="$(readlink "$envdir/previous" 2>/dev/null)" || prev=""
  local curj="null" prevj="null" deploys="[]" d
  [[ -n "$cur" && -f "$envdir/$cur/meta.json" ]] && curj="$(jq -c . "$envdir/$cur/meta.json")"
  [[ -n "$prev" && -f "$envdir/$prev/meta.json" ]] && prevj="$(jq -c . "$envdir/$prev/meta.json")"
  if [[ -d "$envdir/deploys" ]]; then
    deploys="$(for d in "$envdir"/deploys/*/meta.json; do [[ -f "$d" ]] && jq -c '{n, deployed}' "$d"; done | jq -sc '.')"
  fi
  # what runs, from the containers' RepoDigests
  local running="[]" project="$app-$env"
  [[ "$curj" != null ]] && project="$(jq -r --arg p "$project" '.project // $p' <<< "$curj")"
  if command -v docker >/dev/null 2>&1 && [[ "$curj" != null ]]; then
    running="$(running_digests_status "$project" | jq -Rn '[inputs | select(length > 0)]')"
  fi
  # the host's copies of the files, against the payload's
  local files="[]" src dest mode have
  if [[ "$curj" != null && "$(jq -r '.host_files' <<< "$curj")" == true ]]; then
    local p="$envdir/$cur/payload"
    files="$(while IFS=$'\t' read -r src dest mode; do
      [[ -n "$src" ]] || continue
      have="equal"
      if [[ ! -f "$ROOT$dest" ]]; then have="missing"
      elif ! cmp -s "$ROOT$dest" "$p/host_files/$src"; then have="differs"
      elif [[ "$(stat -c %a "$ROOT$dest")" != "${mode#0}" && "$(stat -c %a "$ROOT$dest")" != "$mode" ]]; then have="differs (mode)"; fi
      jq -nc --arg d "$dest" --arg s "$have" '{dest:$d,status:$s}'
    done < <(jq -r '(.deliver.host_files // [])[] | [.src, .dest, (.mode // "0644")] | @tsv' "$p/profile.json") | jq -sc '.')"
  fi
  jq -nc --arg state "$state" --argjson cur "$curj" --argjson prev "$prevj" --argjson deploys "$deploys" \
    --argjson running "$running" --argjson files "$files" \
    '{state:(if $state == "" then null else $state end), current:$cur, previous:$prev, deploys:$deploys, running:$running, host_files:$files}'
}

running_digests_status() {
  local id img
  for id in $(docker ps -q --filter "label=com.docker.compose.project=$1" 2>/dev/null); do
    img="$(docker inspect --format '{{.Image}}' "$id" 2>/dev/null)" || continue
    docker image inspect "$img" --format '{{json .RepoDigests}}' 2>/dev/null | jq -r '.[]? | sub("^.*@"; "")'
  done | sort -u
}

# ------------------------------------------------------------------ root-ops

path_ok() { [[ "$1" == /* && "$1" != *..* ]]; }

# root-ops: the one thing the sudo rule lets this command do as root, and it does
# less than the rule's wildcard allows. What it may do is decided by files only
# root writes, under ${ROOT}/etc/deliver/APP/ (root:root, written by
# `deliver host-install` from the profile at install time, and by root-ops itself):
#   host_files.allow  the destinations a host file may be installed at
#   ephemeral.prefix  the user_prefix of the ephemeral environments' users
#   installed         what root-ops has installed, so only that can be removed
# Nothing under the state folder, which the deploy user writes, is trusted: not a
# payload's profile, not the lists a deploy keeps there.
ALLOW_ROOT="$ROOT/etc/deliver"
allow_app_of() {   # a path under the state folder -> the application it belongs to
  local rel="${1#"$STATE_ROOT"/}"; printf '%s' "${rel%%/*}"
}
same_mode() { [[ "$1" =~ ^[0-7]+$ && "$2" =~ ^[0-7]+$ ]] && (( 8#$1 == 8#$2 )); }
host_file_entry() {   # APP DEST SRC MODE: the allowlist line for exactly that destination, source and mode
  local f="$ALLOW_ROOT/$1/host_files.allow" d
  A_SRC=""; A_MODE=""; A_ENABLE=""
  [[ -f "$f" ]] || return 1
  while IFS=$'\t' read -r d A_SRC A_MODE A_ENABLE; do
    [[ "$d" == "$2" && "$A_SRC" == "$3" ]] && same_mode "$A_MODE" "$4" && return 0
  done < "$f"
  A_SRC=""; A_MODE=""; A_ENABLE=""
  return 1
}
unit_allowed() {   # UNIT: the basename of an allowlisted, enabled destination of some application
  local f d s m e
  for f in "$ALLOW_ROOT"/*/host_files.allow; do
    [[ -f "$f" ]] || continue
    while IFS=$'\t' read -r d s m e; do
      [[ "$e" == true && "$(basename "$d")" == "$1" ]] && return 0
    done < "$f"
  done
  return 1
}
mode_ok() {   # MODE: octal, no setuid, setgid or sticky bit, not writable by others
  [[ "$1" =~ ^0?[0-7]{3}$ ]] || return 1
  (( (8#$1 & 8#7000) == 0 && (8#$1 & 8#0002) == 0 ))
}
installed_dest() {   # DEST: root-ops installed it, for some application
  local f
  for f in "$ALLOW_ROOT"/*/installed; do
    [[ -f "$f" ]] && grep -qxF -- "$1" "$f" && return 0
  done
  return 1
}
record_installed() {   # APP DEST
  local f="$ALLOW_ROOT/$1/installed"
  mkdir -p "$ALLOW_ROOT/$1"
  grep -qxF -- "$2" "$f" 2>/dev/null || printf '%s\n' "$2" >> "$f"
}
forget_installed() {   # DEST
  local f t
  for f in "$ALLOW_ROOT"/*/installed; do
    [[ -f "$f" ]] || continue
    t="$(mktemp "$f.XXXXXX")"; grep -vxF -- "$1" "$f" > "$t" || true; mv -f "$t" "$f"
  done
}
ephemeral_user_ok() {   # NAME: it starts with a prefix host-install recorded (non-empty)
  local f prefix
  for f in "$ALLOW_ROOT"/*/ephemeral.prefix; do
    [[ -f "$f" ]] || continue
    prefix="$(head -1 "$f")"
    [[ -n "$prefix" && "$1" == "$prefix"?* ]] && return 0
  done
  return 1
}
cmd_root_ops() {
  local op="${1:-}"; shift || true
  case "$op" in
    install)
      local src="$1" dest="$2" want_mode="${3:-}" app rel real
      path_ok "$dest" || die "root-ops: bad destination $dest"
      [[ "$src" == "$STATE_ROOT"/* && "$src" != *..* ]] || die "root-ops: the source must be under $STATE_ROOT"
      app="$(allow_app_of "$src")"
      [[ ! -L "$src" && -f "$src" ]] || die "root-ops: the source is not a regular file"
      rel="${src#*/payload/host_files/}"
      host_file_entry "$app" "$dest" "$rel" "$want_mode" || die "root-ops: $dest with source $rel and mode ${want_mode:-?} is not on the host's allowlist for $app: rerun deliver host-install after changing the profile's host_files"
      # a regular file, not a link, resolved under this application's own deploy folders and
      # the one file this destination is listed for
      [[ ! -L "$src" && -f "$src" ]] || die "root-ops: the source is not a regular file"
      real="$(realpath -e -- "$src")" || die "root-ops: cannot resolve the source"
      [[ "$real" == "$(realpath -e -- "$STATE_ROOT")/$app/"*/deploys/*/payload/host_files/"$A_SRC" ]] \
        || die "root-ops: $dest accepts only $A_SRC from a deploy of $app"
      mode_ok "$A_MODE" || die "root-ops: the allowlisted mode $A_MODE for $dest is not allowed (no setuid, setgid, sticky or world-writable)"
      install -D -m "$A_MODE" "$real" "$ROOT$dest" || return 1
      record_installed "$app" "$dest" ;;
    rm)
      path_ok "$1" || die "root-ops: bad path $1"
      installed_dest "$1" || die "root-ops: $1 is not a file root-ops installed"
      rm -f -- "${ROOT}${1:?}"; forget_installed "$1" ;;
    systemctl)
      case "${1:-}:$#" in
        daemon-reload:1) systemctl daemon-reload ;;
        enable:2|disable:2|restart:2|stop:2)
          unit_allowed "$2" || die "root-ops: $2 is not a unit the allowlist derives"
          systemctl "$1" "$2" ;;
        *) die "root-ops: systemctl ${1:-} is not allowed (daemon-reload, or enable, disable, restart or stop of one allowlisted unit)" ;;
      esac ;;
    useradd)
      ephemeral_user_ok "$1" || die "root-ops: $1 does not carry the ephemeral user_prefix"
      useradd -m -d "$2" "$1" ;;
    userdel)
      ephemeral_user_ok "$1" || die "root-ops: $1 does not carry the ephemeral user_prefix"
      userdel "$1" ;;
    *) die "root-ops: unknown operation $op" ;;
  esac
}

# ------------------------------------------------------------------ env create / destroy

ephemeral_payload() {   # APP -> the newest payload folder of any environment
  if [[ -n "${DELIVER_PAYLOAD:-}" ]]; then printf '%s' "$DELIVER_PAYLOAD"; return; fi
  local p; p="$(ls -1dt "$STATE_ROOT/$1"/*/deploys/*/payload 2>/dev/null | head -1)"
  printf '%s' "$p"
}

root_via_sudo() { if [[ "$(id -u)" -eq 0 ]]; then cmd_root_ops "$@"; else sudo -n deliver-host root-ops "$@"; fi; }

cmd_env() {
  local op="${1:-}" name="${2:-}"
  [[ -n "$op" && -n "$name" ]] || die "usage: deliver-host env create|destroy NAME"
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "environment names are lower case letters, digits and dashes"
  local prof="${DELIVER_PROFILE:-}"
  [[ -f "$prof" ]] || die "DELIVER_PROFILE must name the application's profile (app-profile.toml or the payload's profile.json)"
  local pj; if [[ "$prof" == *.json ]]; then pj="$(cat "$prof")"; else pj="$(toml_to_json "$prof")"; fi
  local app prefix home project envdir user
  app="$(jq -r '.application // empty' <<< "$pj")"
  prefix="$(jq -r '.deliver.ephemeral.user_prefix // empty' <<< "$pj")"
  home="$(jq -r '.deliver.ephemeral.home // empty' <<< "$pj")"
  [[ -n "$app" && -n "$prefix" && -n "$home" ]] || die "the profile needs application and [deliver.ephemeral] user_prefix and home"
  user="$prefix$name"; project="$app-$name"; envdir="$(env_dir "$app" "$name")"
  DELIVER_LOG_DIR="$STATE_ROOT/$app/log"; run_log_start "$app" "env-$op" "$name" 2>/dev/null || true
  local payload; payload="$(ephemeral_payload "$app")"
  HOOKS_DIR="$payload/hooks"; REQUIRED_HOOKS=""
  H_APP="$app"; H_ENV="$name"; H_ROLE="ephemeral"; H_SHA=""; H_VERSION=""; H_STATE="$envdir"; H_IMAGES=""
  case "$op" in
    create)
      [[ ! -e "$envdir" ]] || die "environment $name already exists at $envdir"
      root_via_sudo useradd "$user" "$home/$name" || die "cannot create the user $user"
      mkdir -p "$envdir"
      ( umask 077
        {
          printf 'COMPOSE_PROJECT_NAME=%s\n' "$project"
          [[ -z "${DELIVER_REGISTRY:-}" ]] || printf 'DELIVER_REGISTRY=%s\n' "$DELIVER_REGISTRY"
          local s v
          while read -r s <&3; do
            [[ -n "$s" ]] || continue
            printf '%s: ' "$s" >&2
            IFS= read -rs v || true; printf '\n' >&2
            printf '%s=%s\n' "$s" "$v"
          done 3< <(jq -r '(.deliver.ephemeral.secrets // [])[]' <<< "$pj")
        } > "$envdir/.env" )
      chmod 600 "$envdir/.env"
      hook_step env-create || die "the env-create hook failed"
      say "environment $name created (user $user, state $envdir)" ;;
    destroy)
      [[ -d "$envdir" ]] || die "environment $name does not exist"
      hook_step env-destroy || warn "the env-destroy hook failed; continuing"
      docker compose -p "$project" down -v >/dev/null 2>&1 || true
      drop_tmp "$envdir"
      root_via_sudo userdel "$user" || warn "cannot remove the user $user"
      say "environment $name destroyed" ;;
    *) die "usage: deliver-host env create|destroy NAME" ;;
  esac
}

main() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    deploy) [[ $# -ge 2 ]] || die "usage: deliver-host deploy APP ENV < request"; cmd_deploy "$@" ;;
    rollback) [[ $# -ge 2 ]] || die "usage: deliver-host rollback APP ENV < request"; cmd_rollback "$@" ;;
    status) [[ $# -ge 2 ]] || die "usage: deliver-host status APP ENV --json"; cmd_status "$@" ;;
    allowlist) [[ $# -ge 1 ]] || die "usage: deliver-host allowlist APP < lines"; cmd_allowlist "$@" ;;
    copy) [[ $# -ge 1 ]] || die "usage: deliver-host copy APP < request"; cmd_copy "$@" ;;
    root-ops) cmd_root_ops "$@" ;;
    env) cmd_env "$@" ;;
    *) die "usage: deliver-host deploy|rollback|status|copy|allowlist|env|root-ops" ;;
  esac
}
main "$@"
