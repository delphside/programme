#!/usr/bin/env bash
# deploy: steps 5 to 10 of design §11, after the pull and the payload: pre-deploy,
# the new deploy folder, save-state, migrate, host files, compose up, smoke, the
# pivot and the prune. Started by `turpin-host deploy` from the payload taken out
# of the image, with the lock held (the inherited descriptor 9).
#
# The pivot is step 10's one write of state.json. Until it, `current` is the last
# finished deploy, so a failure from step 7 on runs a restore, and one before it
# changes nothing that runs: `turpin-host` writes back the state it found. After
# the pivot the steps run without errexit and a failure is exit 3 (docs/1.10).
set -Eeuo pipefail
PAYLOAD="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
. "$PAYLOAD/lib/common.sh"
# shellcheck source=steps.sh
. "$PAYLOAD/steps.sh"
TURPIN_CMD="turpin-host"
host_ctx_load

CHECK="$(jq -r '.check' "$REQ")"
CUR="$(st current)"

# a hook the profile requires that is missing or not executable refuses, so a
# renamed hook cannot pass silently
for h in $REQUIRED_HOOKS; do
  if [[ ! -e "$HOOKS_DIR/$h" ]]; then gate_fail hooks-present "required hook $h is missing"; fi
  if [[ ! -x "$HOOKS_DIR/$h" ]]; then gate_fail hooks-present "required hook $h is not executable"; fi
done
gate_ok hooks-present "${REQUIRED_HOOKS:-none required}"

# step 5, pre-deploy: a gate
[[ "$CHECK" == true ]] || st_step "preparing: pre-deploy"
hook_gate pre-deploy

if [[ "$CHECK" == true ]]; then
  say "check: the deploy's host gates passed; nothing changed"
  exit 0
fi

# step 6: the next number, recorded as `pending`, then the folder, meta.json last
N="$(next_n)"; DIR="$(deploy_dir "$N")"
st_put '.state = "preparing: deploy-folder" | .pending = $n' --argjson n "$N"
step6_failed() { drop_dir "$DIR"; st_put 'del(.pending)'; die "$1"; }

mkdir -p "$DIR" || step6_failed "cannot make $DIR"
cp -a "$PAYLOAD" "$DIR/payload" || step6_failed "cannot keep the payload"
# the joined files are the commit's, taken from the payload: the environment's own list or the default
JOIN="$(jq -c --slurpfile req "$REQ" '($req[0].env_join // []) as $e | if ($e | length) > 0 then $e else (.turpin.join // []) end' "$PJSON")" || step6_failed "cannot read the joined files"
while read -r f; do
  [[ -n "$f" ]] || continue
  if [[ -e "$PAYLOAD/join/$f" ]]; then
    (cd "$PAYLOAD/join" && cp --parents -a "$f" "$DIR/") || step6_failed "cannot join $f"
  else
    step6_failed "the payload does not carry joined file $f"
  fi
done < <(jq -r '.[]' <<< "$JOIN")
: > "$DIR/turpin.env" || step6_failed "cannot write turpin.env"
while IFS= read -r line; do
  [[ -n "$line" ]] || continue
  printf '%s=%s\n' "$(image_var "${line%%=*}")" "${line#*=}" >> "$DIR/turpin.env" || step6_failed "cannot write turpin.env"
done <<< "$H_IMAGES"
jq -c 'select(.record != null) | .record' "$REQ" > "$DIR/record.json" || step6_failed "cannot write record.json"
jq -nc --argjson n "$N" --slurpfile r "$REQ" --argjson join "$JOIN" --argjson hf "$HOST_FILES" --arg project "$PROJECT" \
  '$r[0] as $q | {n:$n, project:$project, sha:$q.sha, version:$q.version, images:$q.images, role:$q.role, record:$q.record, join:$join, host_files:($hf==1), deployed:null, smoke:null}' \
  > "$DIR/meta.new" || step6_failed "cannot write meta.json"
mv "$DIR/meta.new" "$DIR/meta.json" || step6_failed "cannot write meta.json"

# from step 7 on, a failure runs a restore
fail_deploy() {   # STEP
  trap - ERR
  warn "the deploy failed at $1"
  if ! restore; then
    warn "the restore failed: the state is left at '$(st state)'; run turpin rollback ENV once it can succeed, or put it right by hand. Fallback: $FALLBACK"
    exit 1
  fi
  if [[ -z "$CUR" ]]; then
    warn "no previous deploy to go back to; the new containers are stopped. Fallback: $FALLBACK"
  else
    warn "the previous deploy (#$CUR) is back"
  fi
  exit 1
}

# step 7: changing, then save-state and migrate. Any command that fails from here to the
# pivot and is not checked runs the restore, by the ERR trap.
trap 'fail_deploy "an unexpected error"' ERR
st_put '.state = "changing: deploy save-state" | .target = $n' --argjson n "$N"
hook_numbered save-state "$N" "$CUR" || fail_deploy save-state
st_step "changing: deploy migrate"
hook_step migrate || fail_deploy migrate

# step 8: the host files
if [[ "$HOST_FILES" -eq 1 ]]; then
  st_step "changing: deploy host-files"
  host_files_apply "$N" "$(st_installed)" || fail_deploy host-files
fi

# step 9: compose up, smoke, then what smoke found goes into meta.json
st_step "changing: deploy compose-up"
compose_run "$N" up -d --no-build --remove-orphans || fail_deploy "compose up"
verify_running "$N" || fail_deploy "the digest check of the running containers"
st_step "changing: deploy smoke"
code=0; hook_run smoke || code=$?
if [[ $code -eq 0 ]]; then
  gate_ok smoke
else
  run_log_event gate "name=smoke" "result=refused"; gate_emit smoke refused
  [[ -z "$HOOK_REFUSAL" ]] || warn "$HOOK_REFUSAL"
  warn "refused at gate smoke (exit $code)"; fail_deploy smoke
fi
jq -c --arg t "$(now_utc)" '.deployed = $t | .smoke = "passed"' "$DIR/meta.json" > "$DIR/meta.new" && mv "$DIR/meta.new" "$DIR/meta.json" || fail_deploy "recording the smoke result"

# step 10, the pivot: one write. What it needs is read first, under the trap; the write
# itself is the last thing that can fail before the deploy is live.
HF="$(host_files_of "$N")" || fail_deploy "reading the host files"
trap - ERR
st_put '(if .current != null then .previous = .current else del(.previous) end)
  | .current = .pending | del(.pending, .target)
  | .installed_host_files = $hf | .state = "finished"' --argjson hf "$HF"
say "deployed $H_APP to $H_ENV: deploy #$N"

# after the pivot a failure is exit 3, and the steps carry on
set +e
failed=0
prune_host_images || { warn "pruning the host's images failed; the next deploy prunes again"; failed=1; }
prune_deploys || { warn "pruning the deploy folders failed; the next deploy prunes again"; failed=1; }
exit $(( failed ? EXIT_PARTIAL : 0 ))
