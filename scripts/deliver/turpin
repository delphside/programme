#!/usr/bin/env python3
"""turpin: build, release and deploy an application's image.

The generic tool of delphside/programme#117; its design is
records/2.5-changes/programme-tooling/117-generic-deliver-tool/design.md and
docs/1.1 has its row. This is the entry script: the work is in `turpinlib/`
beside it.
"""

import sys
from pathlib import Path

if sys.version_info < (3, 11, 4):
    print("turpin: Python 3.11.4 or later is needed (tomllib, and tar extraction with a filter)", file=sys.stderr)
    sys.exit(2)

# The real folder, so a symlink to this script (on a PATH) still finds the package.
sys.path.insert(0, str(Path(__file__).resolve().parent))

from turpinlib import cli  # noqa: E402

sys.exit(cli.main(sys.argv[1:]))
