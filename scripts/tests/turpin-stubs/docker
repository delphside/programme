#!/usr/bin/env bash
# A stand-in for docker: pull by digest, image inspect, create/cp/rm for the
# payload, compose up/down/ps, image ls/rmi, and buildx bake (which pushes into
# the directory registry the skopeo stub reads). Per-machine state lives in
# ${TURPIN_HOST_ROOT:-$STUB_LOCAL_ROOT}/.docker. Calls are logged.
set -uo pipefail
R="${STUB_REGISTRY:?}"
S="${TURPIN_HOST_ROOT:-${STUB_LOCAL_ROOT:?}}/.docker"
mkdir -p "$S/images" "$S/containers" "$S/compose"
echo "docker $*" >> "$S/log"
echo "docker $*" >> "${STUB_LOG_DIR:?}/docker.log"
echo "${DOCKER_CONFIG:-}" >> "${STUB_LOG_DIR}/docker-config.log"

. "$(dirname "$0")/stub-auth.sh"
hex() { printf '%s' "$1" | sed 's/^.*@//; s/^sha256://'; }
img_file_for() {   # REF -> the stored image JSON file
  local ref="$1" h f
  if [[ "$ref" == *@sha256:* || "$ref" == sha256:* ]]; then
    h="$(hex "$ref")"; [[ -f "$S/images/$h.json" ]] && { echo "$S/images/$h.json"; return 0; }
    for f in "$S/images"/*.json "$S/local"/*.json; do [[ -f "$f" ]] && [[ "$(jq -r .Id "$f")" == "sha256:$h" || "$(jq -r .Id "$f")" == "$ref" ]] && { echo "$f"; return 0; }; done
    return 1
  fi
  f="$S/local/$(printf '%s' "$ref" | tr '/:' '__').json"; [[ -f "$f" ]] && { echo "$f"; return 0; }
  return 1
}

case "${1:-}" in
  login)
    # the credential arrives on stdin and is never written down: only that it did
    tok="$(cat)"; printf 'login ok bytes=%s\n' "${#tok}" >> "${STUB_LOG_DIR}/login.log"
    shift; user=""; while [[ $# -gt 0 ]]; do case "$1" in -u) user="$2"; shift 2 ;; --password-stdin) shift ;; *) shift ;; esac; done
    jq -nc --arg r "$(stub_role_of_user "$user")" --arg u "$user" '{role:$r,user:$u}' > "$S/login.json"
    echo "docker $user DOCKER_CONFIG=${DOCKER_CONFIG:-}" >> "${STUB_LOG_DIR}/login-dirs.log"
    exit 0 ;;
  pull)
    # shellcheck disable=SC2124
    ref="${@: -1}"
    [[ "${STUB_PULL_SECONDS:-0}" == 0 ]] || sleep "$STUB_PULL_SECONDS"
    repo="${ref%@*}"; d="${ref#*@}"
    stub_auth_check docker pull "${repo#*/}" read
    if [[ -n "${STUB_READ_DENY:-}" && "$repo" =~ $STUB_READ_DENY ]]; then echo "denied" >&2; exit 1; fi
    m="$R/$repo/meta/${d#sha256:}.json"; [[ -f "$m" ]] || { echo "manifest unknown" >&2; exit 1; }
    jq -c --arg ref "$ref" --arg id "sha256:$(printf 'id-%s' "$d" | sha256sum | cut -d' ' -f1)" \
      '{Id:$id, RepoDigests:[$ref], Config:{Labels:.Labels}}' "$m" > "$S/images/${d#sha256:}.json"
    [[ -d "$R/$repo/payload/${d#sha256:}" ]] && cp -a "$R/$repo/payload/${d#sha256:}" "$S/images/${d#sha256:}.payload"
    ;;
  image)
    case "$2" in
      inspect)
        ref="$3"; fmt=""; [[ "${4:-}" == --format ]] && fmt="$5"
        f="$(img_file_for "$ref")" || { echo "No such image: $ref" >&2; exit 1; }
        case "$fmt" in
          *Config.Labels*) jq -c '.Config.Labels' "$f" ;;
          *RepoDigests*) jq -c '.RepoDigests' "$f" ;;
          *.Id*) jq -r '.Id' "$f" ;;
          *) jq -c '[.]' "$f" ;;
        esac ;;
      ls)
        # STUB_LS_HOLD=FILE: wait while FILE exists, saying so in FILE.reached (a test closes the host's input meanwhile)
        if [[ -n "${STUB_LS_HOLD:-}" && -e "$STUB_LS_HOLD" ]]; then
          : > "$STUB_LS_HOLD.reached"; while [[ -e "$STUB_LS_HOLD" ]]; do sleep 0.1; done
        fi
        for f in "$S/images"/*.json; do [[ -f "$f" ]] || continue
          rd="$(jq -r '.RepoDigests[0] // empty' "$f")"; [[ -n "$rd" ]] || continue
          printf '%s:<none> %s %s\n' "${rd%@*}" "sha256:$(hex "$rd")" "$(jq -r .Id "$f")"
        done ;;
    esac ;;
  rmi)
    [[ -z "${STUB_RMI_FAIL:-}" ]] || { echo "Error: unable to remove $2 (simulated)" >&2; exit 1; }
    f="$(img_file_for "$2")" && rm -f "$f" "${f%.json}.payload" ;;
  create)
    f="$(img_file_for "$2")" || { echo "No such image: $2" >&2; exit 1; }
    cid="c$$-$RANDOM"; echo "${f%.json}" > "$S/containers/$cid.src"; echo "$cid" ;;
  cp)
    cid="${2%%:*}"; src="$(cat "$S/containers/$cid.src")"
    [[ -d "$src.payload" ]] || { echo "no /turpin in the image" >&2; exit 1; }
    cp -a "$src.payload/." "$3" ;;
  rm) rm -f "$S/containers/$2.src" ;;
  ps)
    proj="$(printf '%s ' "$@" | sed -n 's/.*label=com.docker.compose.project=\([^ ]*\).*/\1/p')"
    for f in "$S/compose/$proj".*; do [[ -f "$f" ]] && basename "$f"; done ;;
  inspect)
      # shellcheck disable=SC2124
    f="$S/compose/${@: -1}"; [[ -f "$f" ]] || exit 1
    ref="$(head -1 "$f")"; fj="$(img_file_for "$ref")" || { echo "sha256:unknown"; exit 0; }
    jq -r .Id "$fj" ;;
  compose)
    shift; proj=""; envs=(); files=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -p) proj="$2"; shift 2 ;;
        --project-directory) shift 2 ;;
        --env-file) envs+=("$2"); shift 2 ;;
        -f) files+=("$2"); shift 2 ;;
        *) break ;;
      esac
    done
    sub="$1"
    printf 'compose %s project=%s files=%s\n' "$sub" "$proj" "${files[*]:-}" >> "$S/compose.log"
    case "$sub" in
      up)
        if [[ -n "${STUB_COMPOSE_UP_FAIL_ALL:-}" ]]; then echo "compose up failed (simulated, every time)" >&2; exit 1; fi
        if [[ -n "${STUB_COMPOSE_UP_FAIL:-}" && ! -f "$S/up_failed" ]]; then
          : > "$S/up_failed"; echo "compose up failed (simulated)" >&2; exit 1
        fi
        rm -f "$S/compose/$proj".*
        last="${envs[${#envs[@]}-1]}"
        while IFS='=' read -r k v; do
          [[ "$k" == TURPIN_IMAGE_* ]] || continue
          printf '%s\n' "$v" > "$S/compose/$proj.$k"
        done < "$last" ;;
      down)
        [[ -z "${STUB_COMPOSE_DOWN_FAIL:-}" ]] || { echo "compose down failed (simulated)" >&2; exit 1; }
        rm -f "$S/compose/$proj".* ;;
    esac ;;
  buildx)
    # docker buildx bake --builder B T... [--load] --set T.labels.K=V --set T.tags=REF --set T.output=type=oci,dest=DIR,tar=false
    # Under --load the image goes to the machine's local store. Otherwise it is written as an OCI image
    # layout at DIR (relative to the working directory): one image, a manifest, or with STUB_ARCH=multi an
    # index of two platform manifests and an attestation manifest each, the index being the image's digest.
    shift 2; targets=(); sets=(); mode=oci
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --builder) shift 2 ;;
        --load) mode=load; shift ;;
        --set) sets+=("$2"); shift 2 ;;
        *) targets+=("$1"); shift ;;
      esac
    done
    [[ -z "${STUB_BAKE_FAIL:-}" ]] || { echo "bake failed" >&2; exit 1; }
    blob_put() {   # DIR: stdin to DIR/blobs/sha256/HEX; prints HEX
      local tmp h; tmp="$(mktemp)"; cat > "$tmp"; h="$(sha256sum < "$tmp" | cut -d' ' -f1)"
      mkdir -p "$1/blobs/sha256"; mv "$tmp" "$1/blobs/sha256/$h"; printf '%s' "$h"
    }
    descriptor() {   # MEDIATYPE HEX DIR [EXTRA-JSON]
      jq -nc --arg m "$1" --arg d "sha256:$2" --argjson n "$(stat -c %s "$3/blobs/sha256/$2")" --argjson x "${4:-{\}}" '{mediaType:$m,digest:$d,size:$n} + $x'
    }
    image_manifest() {   # DIR CONTENT LABELS TARGET ARCH: writes the layer, config and manifest; prints the manifest's HEX
      local dir="$1" layer config
      layer="$(printf '%s' "$2" | blob_put "$dir")"
      config="$(jq -nc --argjson l "$3" --arg t "$4" --arg a "$5" --arg d "sha256:$layer" \
        '{architecture:$a,os:"linux",config:{Labels:$l,Env:["IMAGE=\($t)"]},rootfs:{type:"layers",diff_ids:[$d]}}' | blob_put "$dir")"
      jq -nc --argjson c "$(descriptor application/vnd.oci.image.config.v1+json "$config" "$dir")" \
        --argjson l "$(descriptor application/vnd.oci.image.layer.v1.tar "$layer" "$dir")" \
        '{schemaVersion:2,mediaType:"application/vnd.oci.image.manifest.v1+json",config:$c,layers:[$l]}' | blob_put "$dir"
    }
    for t in "${targets[@]}"; do
      tags=""; out=""; labels="{}"
      for s in "${sets[@]}"; do
        case "$s" in
          "$t.tags="*) tags="${s#*=}" ;;
          "$t.output="*) out="$(sed -n 's/.*dest=\([^,]*\).*/\1/p' <<< "${s#*=}")" ;;
          "$t.labels."*) k="${s#"$t.labels."}"; labels="$(jq -c --arg k "${k%%=*}" --arg v "${k#*=}" '. + {($k):$v}' <<< "$labels")" ;;
        esac
      done
      content="$(cat src.txt 2>/dev/null)"
      revision="$(jq -r '.["org.opencontainers.image.revision"] // ""' <<< "$labels")"
      if [[ "$mode" == load ]]; then
        d="sha256:$(printf '%s|%s|%s' "$content" "$t" "$revision" | sha256sum | cut -d' ' -f1)"
        mkdir -p "$S/local"
        lf="$S/local/$(printf '%s' "$tags" | tr '/:' '__')"
        jq -nc --arg id "$d" --argjson l "$labels" '{Id:$id, RepoDigests:[], Config:{Labels:$l}}' > "$lf.json"
        [[ -d .turpin-payload ]] && { rm -rf "$lf.payload"; cp -a .turpin-payload "$lf.payload"; }
        continue
      fi
      [[ -n "$out" ]] || { echo "bake stub: no OCI output for $t" >&2; exit 1; }
      rm -rf "$out"; mkdir -p "$out"
      if [[ "${STUB_ARCH:-}" == multi ]]; then
        entries="[]"
        for arch in amd64 arm64; do
          m="$(image_manifest "$out" "$content" "$labels" "$t" "$arch")"
          entries="$(jq -c --argjson e "$(descriptor application/vnd.oci.image.manifest.v1+json "$m" "$out" "{\"platform\":{\"architecture\":\"$arch\",\"os\":\"linux\"}}")" '. + [$e]' <<< "$entries")"
          a="$(image_manifest "$out" "attestation of $content" '{}' "$t" unknown)"
          entries="$(jq -c --argjson e "$(descriptor application/vnd.oci.image.manifest.v1+json "$a" "$out" '{"platform":{"architecture":"unknown","os":"unknown"},"annotations":{"vnd.docker.reference.type":"attestation-manifest"}}')" '. + [$e]' <<< "$entries")"
        done
        top="$(jq -nc --argjson m "$entries" '{schemaVersion:2,mediaType:"application/vnd.oci.image.index.v1+json",manifests:$m}' | blob_put "$out")"
        topmedia=application/vnd.oci.image.index.v1+json
      else
        top="$(image_manifest "$out" "$content" "$labels" "$t" amd64)"
        topmedia=application/vnd.oci.image.manifest.v1+json
      fi
      jq -nc --argjson d "$(descriptor "$topmedia" "$top" "$out")" '{schemaVersion:2,manifests:[$d]}' > "$out/index.json"
      printf '{"imageLayoutVersion":"1.0.0"}' > "$out/oci-layout"
      [[ -d .turpin-payload ]] && cp -a .turpin-payload "$out/payload"
      echo "$t $out" >> "${STUB_LOG_DIR}/bake.log"
    done ;;
  *) echo "docker stub: unsupported: $*" >&2; exit 9 ;;
esac
