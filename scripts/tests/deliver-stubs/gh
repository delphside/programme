#!/usr/bin/env bash
# A stand-in for gh. Reads come from fixtures in $STUB_GH/fix (the REST path with /
# as _, and no query string) overlaid with what earlier calls changed
# ($STUB_GH/state); every write is logged to $STUB_GH/log as one line.
#
# It answers as a cloud session's token is answered: GraphQL is refused, except the
# three calls that set an issue field (the field list, the issue's id, the
# mutation), so the board model reads over REST, as it does where GraphQL is
# refused. The issues are one fixture, repos_<owner>_<name>_issues.json, an array in
# REST's shape; a closed issue, a cleared milestone and a Project State set by a
# call overlay it.
set -uo pipefail
G="${STUB_GH:?}"; mkdir -p "$G/fix" "$G/state"
echo "gh $*" >> "$G/calls"
fail_if() { [[ -n "${STUB_GH_FAIL:-}" && "$1" =~ $STUB_GH_FAIL ]] && { echo "gh: simulated failure ($1)" >&2; exit 1; }; return 0; }

if [[ "$1" == release && "$2" == create ]]; then
  fail_if "release"
  tag="$3"; start=""; shift 3
  while [[ $# -gt 0 ]]; do [[ "$1" == --notes-start-tag ]] && start="$2"; shift; done
  echo "RELEASE create $tag notes-start-tag=$start" >> "$G/log"
  mkdir -p "$G/state/releases"; : > "$G/state/releases/$tag"; exit 0
fi
[[ "$1" == api ]] || { echo "gh stub: unsupported: $*" >&2; exit 9; }
shift
method=GET; fields=(); query=""; path=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -X) method="$2"; shift 2 ;;
    --paginate) shift ;;
    -f|-F)
      kv="$2"; shift 2; fields+=("$kv")
      case "$kv" in query=*) query="${kv#query=}" ;; esac ;;
    *) path="$1"; shift ;;
  esac
done

if [[ "$path" == graphql ]]; then
  fail_if "graphql"
  case "$query" in
    *setIssueFieldValue*)
      issue="$(sed -n 's/.*issueId:"\([^"]*\)".*/\1/p' <<< "$query" | head -1)"
      option="$(sed -n 's/.*singleSelectOptionId:"\([^"]*\)".*/\1/p' <<< "$query" | head -1)"
      echo "GRAPHQL setIssueFieldValue issue=$issue option=$option" >> "$G/log"
      case "$option" in opt-post) name="Post-deployment" ;; opt-dev) name="Development" ;; *) name="$option" ;; esac
      printf '%s\n' "$name" > "$G/state/pstate-${issue#I_}"
      echo '{"data":{"setIssueFieldValue":{"clientMutationId":null}}}'; exit 0 ;;
    *"issueFields(first:30)"*)
      echo '{"data":{"organization":{"issueFields":{"nodes":[{"id":"FLD_1","name":"Project State","options":[{"id":"opt-dev","name":"Development"},{"id":"opt-post","name":"Post-deployment"}]}]}}}}'; exit 0 ;;
    *"{ id }"*)
      n="$(sed -n 's/.*issue(number:\([0-9]*\)).*/\1/p' <<< "$query" | head -1)"
      printf '{"data":{"repository":{"issue":{"id":"I_%s"}}}}\n' "$n"; exit 0 ;;
    *) echo "gh: HTTP 403: Resource not accessible by integration" >&2; exit 1 ;;
  esac
fi

query_string=""; [[ "$path" == *\?* ]] && query_string="${path#*\?}"
path="${path%%\?*}"
param() { sed -n "s/.*\\(^\\|&\\)$1=\\([^&]*\\).*/\\2/p" <<< "$query_string" | head -1; }
fkv() { local kv; for kv in "${fields[@]}"; do [[ "$kv" == "$1="* ]] && { printf '%s' "${kv#*=}"; return; }; done; }
logline() { printf '%s %s' "$method" "$path" >> "$G/log"; for kv in "${fields[@]}"; do printf ' %s' "$kv" >> "$G/log"; done; echo >> "$G/log"; }

if [[ "$method" != GET ]]; then
  fail_if "$method $path"
  logline
  case "$method $path" in
    "POST repos/"*"/milestones")
    # shellcheck disable=SC2010
      n=$((100 + $(ls "$G/state" | grep -c '^ms-new-'))); jq -nc --argjson n "$n" --arg t "$(fkv title)" '{number:$n,title:$t,state:"open"}' > "$G/state/ms-new-$n"
      echo "{\"number\":$n}" ;;
    "POST repos/"*"/issues")
      jq -nc --arg t "$(fkv title)" --arg b "$(fkv body)" '{title:$t,body:$b,state:"open"}' >> "$G/state/issues-new"; echo '{}' ;;
    "PATCH repos/"*"/milestones/"*) : > "$G/state/ms-closed-${path##*/}" ;;
    "PATCH repos/"*"/issues/"*)
      [[ "$(fkv state)" == closed ]] && : > "$G/state/closed-${path##*/}"
      [[ "$(fkv milestone)" == null ]] && : > "$G/state/ms-cleared-${path##*/}"
      echo '{}' ;;
    "POST repos/"*"/issues/"*"/comments")
      n="${path%/comments}"; n="${n##*/}"; jq -nc --arg b "$(fkv body)" '{body:$b}' >> "$G/state/comments-$n"; echo '{}' ;;
    *) echo '{}' ;;
  esac
  exit 0
fi

fail_if "GET $path"
f="$G/fix/$(printf '%s' "$path" | tr '/' '_')"

# the issues fixture with what earlier calls changed laid over it
issues_now() {
  local base='[]' extra closed cleared ps="{}" file
  [[ -f "$f.json" ]] && base="$(cat "$f.json")"
  extra="$(cat "$G/state/issues-new" 2>/dev/null | jq -sc '.')"; [[ -n "$extra" ]] || extra='[]'
  closed="$(ls "$G/state" | sed -n 's/^closed-//p' | jq -Rsc 'split("\n") | map(select(length>0) | tonumber)')"
  cleared="$(ls "$G/state" | sed -n 's/^ms-cleared-//p' | jq -Rsc 'split("\n") | map(select(length>0) | tonumber)')"
  for file in "$G"/state/pstate-*; do
    [[ -f "$file" ]] || continue
    ps="$(jq -c --arg n "${file##*pstate-}" --arg s "$(cat "$file")" '. + {($n): $s}' <<< "$ps")"
  done
  jq -c --argjson e "$extra" --argjson closed "$closed" --argjson cleared "$cleared" --argjson ps "$ps" '
    (. + $e) | map(
      (if (.number // 0) | IN($closed[]) then .state = "closed" else . end)
      | (if (.number // 0) | IN($cleared[]) then .milestone = null else . end)
      | ((.number // 0 | tostring) as $n | if $ps[$n] then
           .issue_field_values = ((.issue_field_values // []) | map(select(.issue_field_name != "Project State"))
             + [{issue_field_name: "Project State", single_select_option: {name: $ps[$n]}}])
         else . end))' <<< "$base"
}

case "$path" in
  repos/*/milestones)
    base='[]'; [[ -f "$f.json" ]] && base="$(cat "$f.json")"
    new="$(cat "$G"/state/ms-new-* 2>/dev/null | jq -sc '.')"; [[ -n "$new" ]] || new='[]'
    closed="$(ls "$G/state" | sed -n 's/^ms-closed-//p' | jq -Rsc 'split("\n") | map(select(length>0) | tonumber)')"
    jq -c --argjson new "$new" --argjson closed "$closed" '(. + $new) | map(if (.number | IN($closed[])) then .state = "closed" else . end)' <<< "$base" ;;
  repos/*/issues)
    page="$(param page)"; page="${page:-1}"; state="$(param state)"; state="${state:-open}"
    if [[ "$page" -gt 1 ]]; then
      [[ -f "${f}_page$page.json" ]] && cat "${f}_page$page.json" || echo '[]'
    else
      issues_now | jq -c --arg s "$state" 'map(select($s == "all" or ((.state // "open") == $s)))'
    fi ;;
  repos/*/issues/*/comments)
    n="${path%/comments}"; n="${n##*/}"
    base='[]'; [[ -f "$f.json" ]] && base="$(cat "$f.json")"
    extra="$(cat "$G/state/comments-$n" 2>/dev/null | jq -sc '.')"; [[ -n "$extra" ]] || extra='[]'
    jq -c --argjson e "$extra" '. + $e' <<< "$base" ;;
  repos/*/issues/*/sub_issues|repos/*/issues/*/dependencies/*)
    [[ -f "$f.json" ]] && cat "$f.json" || echo '[]' ;;
  repos/*/issues/*)
    n="${path##*/}"
    f="$G/fix/$(printf '%s' "${path%/*}" | tr '/' '_')"
    one="$(issues_now | jq -c --argjson n "$n" '[.[] | select(.number == $n)][0] // empty')"
    [[ -n "$one" ]] && echo "$one" || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; } ;;
  repos/*/releases/tags/*)
    [[ -f "$G/state/releases/${path##*/}" || -f "$f.json" ]] && echo '{}' || { echo "gh: Not Found (HTTP 404)" >&2; exit 1; } ;;
  repos/*/commits/*/check-runs)
    [[ -f "$f.json" ]] && cat "$f.json" || echo '{"check_runs":[]}' ;;
  *) [[ -f "$f.json" ]] && cat "$f.json" || { echo "gh: Not Found (HTTP 404): $path" >&2; exit 1; } ;;
esac
